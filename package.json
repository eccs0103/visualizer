{
	"private": true,
	"name": "visualizer",
	"author": "eccs0103",
	"version": "3.3.2",
	"type": "module",
	"packageManager": "npm@11.6.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
