{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": [ "DOM", "DOM.Iterable", "ES2025", "ESNext.Array", "ESNext.Collection" ]
	},
	"include": [
		"environment/models/**/*.ts",
		"environment/controllers/**/*.ts",
		"environment/services/**/*.ts",
		"studio/**/*.ts"
	],
	"exclude": [
		"environment/controllers/coi-worker.ts",
		"studio/controllers/audio-analyzer-worker.ts",
		"studio/controllers/visualization-worker.ts",
		"studio/services/clip-accumulator-worker.ts",
		"studio/services/frame-processor.ts",
		"studio/services/policy-updater.ts",
		"studio/services/worker-visualization.ts"
	]
}
